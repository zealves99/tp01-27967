        "id": "c6e2f488ca7e01c8",
        "type": "function",
        "z": "ad532754904a6f93",
        "name": "Transform to Pie Chart",
        "func": "let seriesData = msg.payload[0]; // pega o objeto do gráfico de barras\nlet pieData = [];\n\nfor (let i = 0; i < seriesData.data[0].length; i++) {\n    let value = seriesData.data[0][i];\n    let label = seriesData.labels[i] || \"Unknown\";\n    if (value > 0) {\n        pieData.push({ label: label.trim(), value: value });\n    }\n}\n\nmsg.payload = pieData;\nreturn msg;\n",
