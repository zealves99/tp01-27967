    {
        "id": "4d28022248d04ac5",
        "type": "function",
        "z": "ad532754904a6f93",
        "name": "Parse Fixture CSV to Objects",
        "func": "// Converte CSV string em array de objetos\nlet lines = msg.payload.split(/\\r?\\n/);\nlet headers = lines.shift().split(';');\nmsg.payload = lines.map(line => {\n    let values = line.split(';');\n    let obj = {};\n    headers.forEach((h,i)=> obj[h.trim()] = values[i]?values[i].trim():null);\n    return obj;\n});\nreturn msg;",
        "outputs": 1,
        "x": 660,
        "y": 160,
        "wires": [
            [
                "2575575518609b38"
            ]
        ]
    },
