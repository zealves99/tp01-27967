    {
        "id": "d0541c661bfe8dfc",
        "type": "function",
        "z": "ad532754904a6f93",
        "name": "Aggregate Power by Layer",
        "func": "let data = {};\nmsg.payload.forEach(row => {\n    let layer = row.Layer || 'Unknown';\n    data[layer] = (data[layer] || 0) + parseFloat(row.PowerUsed || 0);\n});\n\nmsg.payload = [{\n    series: [\"PowerUsed\"],\n    data: [ Object.values(data) ],\n    labels: Object.keys(data)\n}];\n\nreturn msg;\n",
