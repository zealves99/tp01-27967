      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>//Script here
// Gera número aleatório entre 10 e 120
var IntervaloEntreCues = Math.floor(Math.random() * (120 - 10 + 1)) + 10;

// Converte para formato mm:ss
var minutos = Math.floor(IntervaloEntreCues / 60);
var segundos = IntervaloEntreCues % 60;
var IntervaloFormatado = (minutos &lt; 10 ? "0" + minutos : minutos) + ":" + (segundos &lt; 10 ? "0" + segundos : segundos);

</jsScript_script>
      </jsScript>
    </jsScripts>
